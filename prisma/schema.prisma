// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
  MANAGER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

enum CampaignPauseReason {
  DAILY_LIMIT
  ACTIVE_SEND
  PERSISTENCE_FAILURE
  INTERRUPTED
}

model User {
  id                Int        @id @default(autoincrement())
  email             String     @unique
  password          String
  name              String
  role              Role       @default(USER)
  isActive          Boolean    @default(true)
  // Incremented whenever an account change must revoke existing sessions.
  tokenVersion      Int        @default(0)
  lastLoginAt       DateTime?
  resetToken        String?    @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  campaigns         Campaign[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

// Refresh tokens are stored as hashes so a database read leak cannot be used
// to create a new access session. Each token is one-time use and is rotated.
model RefreshToken {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("refreshTokens")
}

model Campaign {
  id                 Int                 @id @default(autoincrement())
  name               String
  subject            String
  htmlContent        String              @db.Text
  status             CampaignStatus      @default(DRAFT)
  pauseReason        CampaignPauseReason?
  sendMode           String              @default("immediate")
  scheduledAt        DateTime?
  totalCount         Int                 @default(0)
  dailyLimit         Int                 @default(50)
  createdBy          Int?
  user               User?               @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  recipients         String              @db.MediumText
  attachments        String?             @db.MediumText
  assignedCampaigns  assignedCampaigns[]
  deliveries         EmailDelivery[]
  failures           EmailFailure[]
  isAssigned         Boolean             @default(false)

  @@map("campaigns")
}

model Contact {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  name               String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignedCampaigns  assignedCampaigns[]
  emailDeliveries    EmailDelivery[]
  emailFailures      EmailFailure[]
  @@map("contacts")
}

enum AssignmentDeliveryStatus {
  PENDING
  SENT
}

// Join table: depends on Contact + Campaign (FK lives here).
// Deleting a contact/campaign cascades and removes assignment rows.
// Contact/Campaign do not depend on assignments — they only expose the back-relation Prisma requires.

model assignedCampaigns {
  id              Int                         @id @default(autoincrement())
  campaignId      Int
  campaign        Campaign                    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId       Int
  contact         Contact                     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deliveryStatus  AssignmentDeliveryStatus    @default(PENDING)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([campaignId, contactId])
  @@map("assignedCampaigns")
}

// Immutable history of every successfully delivered campaign email.
// Assignment rows remain the pending/send queue; this model is the audit trail.
model EmailDelivery {
  id             Int       @id @default(autoincrement())
  campaignId     Int?
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contactId      Int?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recipientEmail String    @db.VarChar(254)
  subject        String    @db.VarChar(998)
  sentAt         DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([campaignId, sentAt])
  @@index([contactId])
  @@map("emailDeliveries")
}

// Temporary reservation used to prevent concurrent senders from exceeding
// the global quota or sending the same campaign recipient twice.
model EmailSendReservation {
  id             Int      @id @default(autoincrement())
  campaignId     Int
  recipientEmail String   @db.VarChar(254)
  reservedAt     DateTime @default(now())

  @@index([reservedAt])
  @@unique([campaignId, recipientEmail])
  @@map("emailSendReservations")
}

// Singleton row used to serialize quota reservations across app instances.
model EmailQuotaLock {
  id        Int      @id @default(1)
  updatedAt DateTime @updatedAt

  @@map("emailQuotaLocks")
}

// Immutable history of failed delivery attempts. A later successful retry is
// represented by EmailDelivery and removes the address from the active failed
// view while preserving the original failure audit trail.
model EmailFailure {
  id              Int       @id @default(autoincrement())
  campaignId      Int
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId       Int?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recipientEmail  String    @db.VarChar(254)
  reason          String    @db.Text
  failedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([campaignId, failedAt])
  @@index([contactId])
  @@map("emailFailures")
}
