# Database connection parts. DATABASE_URL is generated automatically.
DB_HOST=your host
DB_PORT=your port
DB_NAME=your db name
DB_USER=your username
DB_PASSWORD=your password
DB_SSL_MODE=REQUIRED

PORT= Port number for the backend server to listen on
NODE_ENV=development

# Admin account used by the API bootstrap/seed process.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

SMTP_HOST=your host
SMTP_PORT= your port
SMTP_SECURE=
SMTP_USER=your username
SMTP_PASS=your password

# Set true only for a one-time generated admin password reset, then remove it.
ADMIN_RESET_PASSWORD=false

SCHEDULER_ENABLED=true
FRONTEND_URL= url of your frontend application
LOG_LEVEL=info
LOG_DIR=logs
