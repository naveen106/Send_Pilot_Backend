# Database connection parts. DATABASE_URL is generated automatically.
DB_HOST=your host
DB_PORT=your port
DB_NAME=your db name
DB_USER=your username
DB_PASSWORD=your password

#set this to DISABLED if you are using a local database without SSL
DB_SSL_MODE=REQUIRED
# Optional path to the database provider's CA certificate. The file must exist
# inside the runtime/container. Leave unset when the provider certificate is
# already trusted by the runtime.
# DB_CA_PATH=/path/to/ca.pem

# Prisma connection pool. Lower this if the database plan has a small limit.
PRISMA_CONNECTION_LIMIT=3
PRISMA_POOL_TIMEOUT=30

PORT=5000
NODE_ENV=development

# Admin account used by the API bootstrap/seed process.
# Put your email and password here to generate an admin account on first migrate.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

#Json web token secret and expiration time
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m


#Email and settings that you want to use to send emails from the application.
#This is not necessarily the same as the admin email.
SMTP_HOST=your host
SMTP_PORT= your port
SMTP_SECURE=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=your_username / email
SMTP_PASS=your_password

# Maximum emails all campaigns may send in a rolling 24-hour period.
MAX_DAILY_EMAILS=200

# Scheduler settings. Set to false if you want to disable the scheduler.
SCHEDULER_ENABLED=true

#url where the frontend is running.
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_DIR=logs
