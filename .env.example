# Database connection parts. DATABASE_URL is generated automatically.
DB_HOST=your host
DB_PORT=your port
DB_NAME=your db name
DB_USER=your username
DB_PASSWORD=your password
DB_SSL_MODE=REQUIRED

# Prisma connection pool. Lower this if the database plan has a small limit.
PRISMA_CONNECTION_LIMIT=3
PRISMA_POOL_TIMEOUT=30

PORT=5000
NODE_ENV=development

# Admin account used by the API bootstrap/seed process.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

SMTP_HOST=your host
SMTP_PORT= your port
SMTP_SECURE=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=your username
SMTP_PASS=your password

# Maximum emails all campaigns may send in a rolling 24-hour period.
MAX_DAILY_EMAILS=200

SCHEDULER_ENABLED=true
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
LOG_DIR=logs
